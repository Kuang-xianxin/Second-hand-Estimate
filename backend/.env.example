# ======================
# 估二手后端 - 环境变量模板
# 复制此文件为 .env 并填写真实值
# ======================

# DeepSeek API Key (用于 AI 价格分析)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 阿里云百炼 Qwen API Key
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 字节豆包 API Key
DOUBAO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 管理员令牌（用于保护管理接口）
ADMIN_TOKEN=your_secure_random_token_here

# 后端监听端口（默认 8000）
BACKEND_PORT=8000

# 前端 URL（用于 CORS，允许跨域访问，* 表示全部）
FRONTEND_URL=*

# Database
# Local dev fallback:
# DATABASE_URL=sqlite+aiosqlite:///./guessr.db
#
# Production PostgreSQL, recommended through PgBouncer.
# Use host.docker.internal when PgBouncer runs on the Docker host.
# DATABASE_URL=postgresql+asyncpg://ccd_user:change_me@host.docker.internal:6432/ccd_db
DATABASE_URL=sqlite+aiosqlite:///./guessr.db

# Redis L1 cache
REDIS_URL=redis://localhost:6379/0

# 爬虫间隔（秒）
CRAWL_INTERVAL_SECONDS=300

# 每查询最大商品数
MAX_ITEMS_PER_QUERY=60

# 捡漏阈值（元），商品价格低于此值触发捡漏提醒
BARGAIN_THRESHOLD=120.0
