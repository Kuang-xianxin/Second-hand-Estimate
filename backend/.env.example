# ======================
# 估二手后端 - 环境变量模板
# 复制此文件为 .env 并填写真实值
# ======================

# ── LLM API Keys ──
DEEPSEEK_API_KEY=sk-your-key-here
QWEN_API_KEY=sk-your-key-here
DOUBAO_API_KEY=your-doubao-key
KIMI_API_KEY=sk-your-key-here

# ── Admin ──
ADMIN_TOKEN=your-secure-random-token

# ── LLM Models (通常不需要改) ──
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_MODEL=qwen-max
# DOUBAO_MODEL=ep-m-20260327193150-m6442
# KIMI_MODEL=kimi-k2.6
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ── Database / Server ──
DATABASE_URL=sqlite+aiosqlite:///./guessr.db
# REDIS_URL=redis://localhost:6379/0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Production ──
# IS_PRODUCTION=true
# SITE_AUTH_REQUIRED=true

# ── Crawl Core ──
CRAWL_ENABLED=true
CRAWL_INTERVAL_SECONDS=300
CRAWL_SCHEDULER_MODE=embedded
# CRAWL_STABILITY_MODE=false
# CRAWL_STOP_ON_RISK=true
# CRAWL_CANARY_ENABLED=true

# ── Crawl Concurrency ──
# CRAWL_CONCURRENCY=1
# CRAWL_CONCURRENCY_MAX=3

# ── Crawl Rate / Cooldown ──
# CRAWL_MIN_INTERVAL_SECONDS=180
# CRAWL_FAILURE_COOLDOWN_SECONDS=1800

# ── Items / Crawl Scope ──
MAX_ITEMS_PER_QUERY=60
MAX_ITEMS_PER_CRAWL_KEYWORD=40

# ── Bargain ──
BARGAIN_THRESHOLD=120.0

# ── Auth ──
# APP_SESSION_TTL_SECONDS=86400
