# ======================
# 估二手后端 - 环境变量模板
# 复制此文件为 .env 并填写真实值
# ======================

# DeepSeek API Key (用于 AI 价格分析)
DEEPSEEK_API_KEY=replace_me

# 阿里云百炼 Qwen API Key
QWEN_API_KEY=replace_me

# 字节豆包 API Key
DOUBAO_API_KEY=replace_me

# 管理员令牌（用于保护管理接口）
ADMIN_TOKEN=your_secure_random_token_here

# Environment: development / production
ENVIRONMENT=development

# 后端监听端口（默认 8000）
BACKEND_PORT=8000

# 前端 URL（生产环境必须使用明确域名，不允许 *）
FRONTEND_URL=*
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=*
SITE_AUTH_REQUIRED=false

# Password reset is disabled until SMTP is configured.
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Database
# Local dev fallback:
# DATABASE_URL=sqlite+aiosqlite:///./guessr.db
#
# Production PostgreSQL, recommended through PgBouncer.
# Use host.docker.internal when PgBouncer runs on the Docker host.
# DATABASE_URL=postgresql+asyncpg://ccd_user:change_me@host.docker.internal:6432/ccd_db
DATABASE_URL=sqlite+aiosqlite:///./guessr.db

# Redis L1 cache
REDIS_URL=redis://localhost:6379/0

# 爬虫间隔（秒）
CRAWL_INTERVAL_SECONDS=300
CRAWL_ENABLED=false
# production: external; development: embedded
CRAWL_SCHEDULER_MODE=embedded
CRAWL_CANARY_ENABLED=true
CRAWL_STOP_ON_RISK=true
CRAWL_CONCURRENCY=1
CRAWL_CONCURRENCY_MAX=1

# 每查询最大商品数
MAX_ITEMS_PER_QUERY=60

# 捡漏阈值（元），商品价格低于此值触发捡漏提醒
BARGAIN_THRESHOLD=120.0
