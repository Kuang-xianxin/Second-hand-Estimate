ADMIN_TOKEN=replace_with_at_least_32_random_characters
DATABASE_URL=postgresql+asyncpg://ccd_user:replace_me@host.docker.internal:6432/ccd_db
REDIS_URL=redis://host.docker.internal:6379/0
FRONTEND_URL=https://secondhandestimate.duckdns.org
CORS_ORIGINS=https://secondhandestimate.duckdns.org
TRUSTED_HOSTS=secondhandestimate.duckdns.org,localhost,127.0.0.1

DEEPSEEK_API_KEY=
QWEN_API_KEY=
DOUBAO_API_KEY=

CRAWL_ENABLED=true
CRAWL_SCHEDULER_MODE=external
INITIAL_CRAWL_ENABLED=false
CRAWL_INTERVAL_SECONDS=5400
CRAWL_CANARY_ENABLED=false
CRAWL_STOP_ON_RISK=true
MAX_ITEMS_PER_QUERY=200
CRAWL_CONCURRENCY=1
CRAWL_CONCURRENCY_MAX=1
CRAWL_STABILITY_MODE=true
CRAWL_KEYWORDS_PER_RUN=1
CRAWL_MIN_INTERVAL_SECONDS=180
CRAWL_COVERAGE_TARGET_SECONDS=172800
CRAWL_FAILURE_COOLDOWN_SECONDS=1800
CRAWL_RISK_COOLDOWN_SECONDS=604800
CRAWL_MAX_COOLDOWN_SECONDS=2592000
CRAWL_DYNAMIC_CONCURRENCY=false
MAX_ITEMS_PER_QUERY_T0=20
MAX_PAGES_PER_QUERY=1
CRAWL_BATCH_SIZE=1

PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
